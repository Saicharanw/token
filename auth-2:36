import api from "./axios";

export const signup = async (userData) => {
  if (!userData.name || !userData.username || !userData.email || !userData.password) {
    throw new Error("Name, username, email, and password are required");
  }

  try {
    const response = await api.post("/auth/signup", {
      name: userData.name,
      username: userData.username,
      email: userData.email,
      password: userData.password,
    });
    const { accessToken, refreshToken, name, email } = response.data;

    localStorage.setItem("accessToken", accessToken);
    localStorage.setItem("refreshToken", refreshToken);
    localStorage.setItem("name", name || "");
    localStorage.setItem("email", email || "");

    return response.data;
  } catch (error) {
    throw new Error(
      JSON.stringify({
        message: error.response?.data?.message || "Failed to create account",
        status: error.response?.status || 500,
      })
    );
  }
};

export const login = async (credentials) => {
  if (!credentials.email || !credentials.password) {
    throw new Error("Email and password are required");
  }

  try {
    const response = await api.post("/auth/login", {
      username: credentials.email, // Backend expects email as username
      password: credentials.password,
    });
    const { accessToken, refreshToken, name, email } = response.data;

    localStorage.setItem("accessToken", accessToken);
    localStorage.setItem("refreshToken", refreshToken);
    localStorage.setItem("name", name || "");
    localStorage.setItem("email", email || "");

    return response.data;
  } catch (error) {
    throw new Error(
      JSON.stringify({
        message: error.response?.data?.message || "Failed to login",
        status: error.response?.status || 500,
      })
    );
  }
};
